{
  "name": "sumday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sumday - a crossword-style math puzzle game.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm start --workspace @sumday/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
